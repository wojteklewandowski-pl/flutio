{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "dev: serwer z podglądem na żywo",
      "type": "npm",
      "script": "dev",
      "isBackground": true,
      "problemMatcher": {
        "owner": "vite",
        "pattern": { "regexp": "^x^" },
        "background": { "activesBegin": ".*", "beginsPattern": "VITE", "endsPattern": "Local:" }
      },
      "group": "build"
    },
    { "label": "build: wersja produkcyjna (dist/)", "type": "npm", "script": "build", "problemMatcher": ["$tsc"], "group": { "kind": "build", "isDefault": true } },
    { "label": "typecheck", "type": "npm", "script": "typecheck", "problemMatcher": ["$tsc"] },
    { "label": "test", "type": "npm", "script": "test", "problemMatcher": [], "group": { "kind": "test", "isDefault": true } },
    { "label": "preview: podgląd dist/", "type": "npm", "script": "preview", "isBackground": true, "problemMatcher": [] }
  ]
}
