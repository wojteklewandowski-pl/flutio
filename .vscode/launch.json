{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Chrome: debuguj aplikację (uruchamia serwer dev)",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}",
      "preLaunchTask": "dev: serwer z podglądem na żywo"
    },
    {
      "name": "Vitest: debuguj testy",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/node_modules/vitest/vitest.mjs",
      "args": ["run"],
      "console": "integratedTerminal",
      "autoAttachChildProcesses": true
    }
  ]
}
